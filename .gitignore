# Generated by Cargo
# will have compiled files and executables
.vscode/
debug/
target/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Local JAR reverse-engineering references; never ship with the decoder.
/crates/unarc-rs/src/jar/exe/
/crates/unarc-rs/src/jar/disasm/
